// ═══════════════════════════════════════════════════════
// FORGE — Firestore Security Rules
//
// HOW TO APPLY: Firebase Console → your project (forge-8e1b2) →
// Firestore Database → Rules tab → select all existing text → paste
// this in its place → Publish.
//
// IMPORTANT: this REPLACES whatever rules currently exist. It covers
// both collections FORGE uses (users, leaderboard). If you've added
// any other collection/rules since setup that aren't reflected here,
// check before overwriting — this file doesn't know about anything
// outside what's in this repo's firebase.js.
// ═══════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── PRIVATE USER DATA ──
    // Only the account owner can ever read or write their own document.
    // Holds the FULL app state — tasks, goals, sessions, everything.
    // Nothing here is ever readable by anyone else.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── PUBLIC LEADERBOARD ──
    // Anyone signed in can read the whole collection (needed to show
    // rankings). You can only write your OWN entry — and only within
    // sane bounds.
    //
    // Honest limit of what this can do: these rules can't prove your
    // numbers are TRUE — that would require a server (Cloud Functions),
    // which isn't available without a billing-enabled Firebase plan.
    // What they DO block is the obvious attack: opening DevTools and
    // writing an arbitrary huge number directly to Firestore. Someone
    // could still edit their own PRIVATE save data first and legitimately
    // sync that up — closing that hole would mean moving XP-granting
    // itself server-side, which breaks offline mode. Deliberate,
    // documented trade-off for an app at this scale.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;

      // Shared validation, used by both create and update below.
      function validEntry() {
        return request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 20
          && request.resource.data.avatar is string
          && request.resource.data.level is int
          && request.resource.data.level >= 1
          && request.resource.data.level <= 500
          && request.resource.data.streak is int
          && request.resource.data.streak >= 0
          && request.resource.data.streak <= 3660
          && request.resource.data.totalHours is number
          && request.resource.data.totalHours >= 0
          && request.resource.data.totalHours <= 20000;
      }

      // First-ever sync for an account — no existing document to
      // compare against, so no jump-limiting applies here (there's
      // nothing to have "jumped" from).
      allow create: if request.auth != null
        && request.auth.uid == uid
        && validEntry();

      // Every sync after the first — bounds-checked AND jump-limited
      // against whatever was there before.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && validEntry()
        && request.resource.data.level      <= resource.data.level      + 5
        && request.resource.data.streak     <= resource.data.streak     + 3
        && request.resource.data.totalHours <= resource.data.totalHours + 12;
    }
  }
}
